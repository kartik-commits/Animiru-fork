CREATE VIEW historyView AS
SELECT
    history.id AS id,
    coalesce(parent.id, anime.id) AS animeId,
    episode.id AS episodeId,
    -- AM -->
    coalesce(parent.user_custom_title, anime.user_custom_title) AS custom_title,
    -- <-- AM
    coalesce(parent.remote_title, anime.remote_title) AS title,
    coalesce(nullif(anime.remote_cover, ''), parent.remote_cover) AS thumbnailUrl,
    coalesce(parent.source_id, anime.source_id) AS sourceId,
    (coalesce(parent.user_favorite_at, anime.user_favorite_at) IS NOT NULL) AS favorite,
    coalesce(parent.state_cover_last_modified, anime.state_cover_last_modified) AS coverLastModified,
    episode.remote_episode_number AS episodeNumber,
    history.seen_at AS seenAt,
    max_seen.seen_at AS maxSeenAt,
    max_seen.episode_id AS maxSeenAtEpisodeId
FROM anime
LEFT JOIN anime AS parent
ON anime.state_parent_id = parent.id
JOIN episode
ON anime.id = episode.anime_id
JOIN history
ON episode.id = history.episode_id
JOIN (
    SELECT
        coalesce(anime.state_parent_id, anime.id) AS series_id,
        history.episode_id,
        MAX(history.seen_at) AS seen_at
    FROM history
    JOIN episode ON history.episode_id = episode.id
    JOIN anime ON episode.anime_id = anime.id
    GROUP BY series_id
) AS max_seen
ON coalesce(anime.state_parent_id, anime.id) = max_seen.series_id;

history:
SELECT
id,
animeId,
episodeId,
custom_title,
title,
thumbnailUrl,
sourceId,
favorite,
coverLastModified,
episodeNumber,
seenAt
FROM historyView
WHERE historyView.seenAt IS NOT NULL
AND maxSeenAtEpisodeId = historyView.episodeId
AND lower(historyView.title) LIKE ('%' || :query || '%')
ORDER BY seenAt DESC;

getLatestHistory:
SELECT
id,
animeId,
episodeId,
custom_title,
title,
thumbnailUrl,
sourceId,
favorite,
coverLastModified,
episodeNumber,
seenAt
FROM historyView
WHERE historyView.seenAt IS NOT NULL
ORDER BY seenAt DESC
LIMIT 1;
