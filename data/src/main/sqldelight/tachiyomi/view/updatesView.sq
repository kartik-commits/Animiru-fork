import kotlin.Int;

CREATE VIEW updatesView AS
SELECT
    anime.id AS animeId,
    -- AM -->
    coalesce(parent.user_custom_title, anime.user_custom_title) AS customAnimeTitle,
    -- <-- AM
    coalesce(parent.remote_title, anime.remote_title) AS animeTitle,
    episode.id AS episodeId,
    episode.remote_name AS episodeName,
    episode.remote_scanlator AS scanlator,
    episode.remote_url AS episodeUrl,
    episode.user_seen AS seen,
    episode.user_bookmark AS bookmark,
    -- AY -->
    episode.remote_fillermark AS fillermark,
    -- <-- AY
    episode.user_last_second_seen AS lastSecondSeen,
    -- AY -->
    episode.state_total_seconds AS totalSeconds,
    -- <-- AY
    coalesce(parent.source_id, anime.source_id) AS sourceId,
    (coalesce(parent.user_favorite_at, anime.user_favorite_at) IS NOT NULL) AS favorite,
    coalesce(nullif(anime.remote_cover, ''), parent.remote_cover) AS thumbnailUrl,
    coalesce(parent.state_cover_last_modified, anime.state_cover_last_modified) AS coverLastModified,
    episode.remote_date_upload AS dateUpload,
    episode.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator,
    parent.id AS parentId
FROM anime
LEFT JOIN anime AS parent
ON anime.state_parent_id = parent.id
JOIN episode
ON anime.id = episode.anime_id
LEFT JOIN excluded_scanlator
ON anime.id = excluded_scanlator.anime_id
AND episode.remote_scanlator = excluded_scanlator.scanlator
WHERE coalesce(parent.user_favorite_at, anime.user_favorite_at) IS NOT NULL
AND episode.state_date_fetch > coalesce(parent.user_favorite_at, anime.user_favorite_at)
ORDER BY episode.state_date_fetch DESC;

getRecentUpdatesWithFilters:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName, scanlator, episodeUrl, seen,
    bookmark, fillermark, lastSecondSeen, totalSeconds, sourceId, favorite, thumbnailUrl,
    coverLastModified, dateUpload, dateFetch, excludedScanlator, parentId
FROM updatesView
WHERE dateUpload > :after
AND (:seen IS NULL OR seen = :seen)
-- Started means some progress but not finished, Seen means finished episode, thus:
AND (
    :started IS NULL
    OR (:started = 1 AND lastSecondSeen > 0 AND seen = 0)
    OR (:started = 0 AND lastSecondSeen = 0 AND seen = 0)
)
AND (:bookmarked IS NULL OR bookmark = :bookmarked)
AND (:fillermarked IS NULL OR fillermark = :fillermarked)
AND (excludedScanlator IS NULL OR :hideExcludedScanlators = 0)
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM anime_category
        WHERE anime_category.anime_id = coalesce(parentId, animeId)
        AND anime_category.category_id IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM anime_category WHERE anime_category.anime_id = coalesce(parentId, animeId))
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM anime_category
            WHERE anime_category.anime_id = coalesce(parentId, animeId)
            AND anime_category.category_id IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM anime_category WHERE anime_category.anime_id = coalesce(parentId, animeId))
        )
    )
)
ORDER BY dateFetch DESC
LIMIT :limit;

getSeenUpdates:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName, scanlator, episodeUrl, seen,
    bookmark, fillermark, lastSecondSeen, totalSeconds, sourceId, favorite, thumbnailUrl,
    coverLastModified, dateUpload, dateFetch, excludedScanlator, parentId
FROM updatesView
WHERE seen = 1
AND dateUpload > :after
ORDER BY dateFetch DESC
LIMIT :limit;

getUnseenUpdates:
SELECT
    animeId, customAnimeTitle, animeTitle, episodeId, episodeName, scanlator, episodeUrl, seen,
    bookmark, fillermark, lastSecondSeen, totalSeconds, sourceId, favorite, thumbnailUrl,
    coverLastModified, dateUpload, dateFetch, excludedScanlator, parentId
FROM updatesView
WHERE seen = 0
AND dateUpload > :after
ORDER BY dateFetch DESC
LIMIT :limit;
